predictors <- merged_summer %>%
select(DBH, Height, WP, LWC, RWC, LT, LDMC)
# Correlation matrix (pairwise, excluding NAs)
cor_matrix <- cor(predictors, use = "pairwise.complete.obs")
# Print the correlation matrix
