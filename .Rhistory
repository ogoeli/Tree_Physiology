Slope ~ z_WP + z_DBH + z_LWC + z_LDMC + z_Height + Stress_Level + SP_CODE,
random = ~1 | PLOT,
method = "REML",
na.action = na.omit,
data = model_data
)
summary(H2)
tab_model(H2)
#summary(M1.nested)
lme2_ml <- update(H2, method = "ML")
drop1(lme2_ml, test = "Chisq")
